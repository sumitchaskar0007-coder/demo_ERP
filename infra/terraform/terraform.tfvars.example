project_name    = "college-erp"
environment     = "preprod"
aws_region      = "ap-south-1"
temporary_domain = false
domain_name     = "erp.example.com"
api_domain_name = "api.erp.example.com"
route53_zone_id = "Z0000000000000000000"
backend_image   = "000000000000.dkr.ecr.ap-south-1.amazonaws.com/college-erp-preprod-backend:v1.0.0"
desired_count   = 2
backend_task_cpu                 = 1024
backend_task_memory              = 2048
backend_autoscaling_min_capacity = 2
backend_autoscaling_max_capacity = 12
backend_autoscaling_cpu_target   = 60
backend_autoscaling_memory_target = 70
backend_requests_per_target       = 900
backend_peak_schedule_enabled     = false
backend_peak_capacity             = 8
backend_db_pool_max_size          = 12
backend_db_pool_min_idle          = 2
database_connection_budget        = 180
waf_public_auth_edge_limit        = 10000
async_queues_enabled              = true
async_worker_desired_count        = 1
async_worker_task_cpu             = 512
async_worker_task_memory          = 1024
async_worker_db_pool_max_size     = 4
async_worker_db_pool_min_idle     = 1
malware_protection_enabled        = true
alert_email     = "operations@example.com"
mail_enabled    = true
github_repository = "your-github-owner/College-ERP"
# Keep true only for the one state that owns the account-global provider.
manage_github_oidc_provider = true
