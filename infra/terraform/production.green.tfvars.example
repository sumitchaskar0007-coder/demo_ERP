# Apply after the private production.tfvars and the live-configuration pin file.
# This file only creates the isolated Green API/cache path. Normal Blue traffic
# remains on the existing service because the Green listener rule also requires
# a high-entropy deployment-slot query value.

green_enabled         = true
green_cutover_enabled = false
green_desired_count   = 2

# Must be an ARM64 image built from the reviewed release commit and pinned by
# digest. Never reuse the currently deployed AMD64-only digest here.
green_backend_image = "814645955631.dkr.ecr.ap-south-1.amazonaws.com/college-erp-production-ecs-backend@sha256:replace-with-arm64-digest"

# Production metrics support half the current CPU while memory remains at 2 GiB.
green_backend_task_cpu    = 256
green_backend_task_memory = 2048

# Start passive. Activate queue consumers only after the protected readiness
# probe is healthy; enable recovery/polling only after Blue worker stops.
green_worker_enabled             = false
green_worker_active              = false
green_worker_maintenance_enabled = false
green_worker_task_cpu            = 256
green_worker_task_memory         = 1024

# Hard capacity ceilings prevent an unexpected Green validation workload from
# scaling serverless Valkey beyond the reviewed cost envelope.
green_cache_max_storage_gib      = 1
green_cache_max_ecpu_per_second  = 5000
