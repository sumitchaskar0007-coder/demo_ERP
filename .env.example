# LOCAL environment only. Copy to .env and replace every CHANGE_ME value before
# using Docker Compose. Preproduction and production use ECS/Secrets Manager.
# Never commit the resulting .env file.

APP_ENVIRONMENT=local
IMAGE_TAG=local
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
TZ=Asia/Kolkata

POSTGRES_DB=college_erp
DB_USERNAME=erp_app
DB_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
FLYWAY_ENABLED=true
FLYWAY_POSTGRESQL_TRANSACTIONAL_LOCK=false

JWT_SECRET=CHANGE_ME_RANDOM_VALUE_AT_LEAST_32_CHARACTERS
JWT_EXPIRATION_MS=900000
RATE_LIMIT_KEY_SECRET=CHANGE_ME_INDEPENDENT_RANDOM_RATE_LIMIT_SECRET
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
CACHE_ENVIRONMENT=local-compose

AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Strict

BOOTSTRAP_ENABLED=false
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=

MAIL_ENABLED=false
MAIL_HEALTH_ENABLED=false
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_SMTP_USERNAME
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Jadhavar ERP
MAIL_REPLY_TO=support@example.com
MAIL_BATCH_SIZE=20
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLED=true
MAIL_STARTTLS_REQUIRED=true
MAIL_MAX_RETRIES=3
MAIL_RETRY_DELAY_SECONDS=60
MAIL_TOKEN_EXPIRY_MINUTES=30
MAIL_CONNECTION_TIMEOUT=5000
MAIL_TIMEOUT=5000
MAIL_WRITE_TIMEOUT=5000
MAIL_TRANSPORT=database
EMAIL_SQS_PUBLISHER_ENABLED=false
EMAIL_SQS_CONSUMER_ENABLED=false
EMAIL_SQS_RECOVERY_ENABLED=false
EMAIL_SQS_QUEUE_URL=
EMAIL_SQS_WAIT_TIME_SECONDS=20
EMAIL_SQS_VISIBILITY_TIMEOUT_SECONDS=120
EMAIL_SQS_MAX_MESSAGES=10
EMAIL_SQS_POLL_DELAY_MS=1000
EMAIL_SQS_RECOVERY_DELAY_MS=60000
EMAIL_SQS_RECOVERY_AGE_SECONDS=60
EMAIL_SQS_RECOVERY_BATCH_SIZE=100

AWS_REGION=ap-south-1
AWS_PRIVATE_UPLOAD_BUCKET=
AWS_SECRETS_NAME=

JVM_MAX_RAM_PERCENTAGE=75.0
JVM_INITIAL_RAM_PERCENTAGE=25.0
