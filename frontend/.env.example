# Leave blank for local development. Vite proxies /api to port 8081.
VITE_API_BASE_URL=

# Set to false for a controlled rollback to backend-proxied multipart document transfers.
# Keep the backend-mediated S3 upload path unless direct browser-to-S3 CORS
# and presigned-upload infrastructure have been explicitly verified.
VITE_ADMISSION_DIRECT_TRANSFER_ENABLED=false
