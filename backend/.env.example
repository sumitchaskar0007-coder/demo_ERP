EMAIL_SQS_VISIBILITY_TIMEOUT_SECONDS=120
EMAIL_SQS_MAX_MESSAGES=10
EMAIL_SQS_POLL_DELAY_MS=1000
EMAIL_SQS_RECOVERY_DELAY_MS=60000
EMAIL_SQS_RECOVERY_AGE_SECONDS=60
EMAIL_SQS_RECOVERY_BATCH_SIZE=100
REPORT_EXPORTS_ENABLED=false
REPORT_DATABASE_POLL_ENABLED=false
REPORT_SQS_PRODUCER_ENABLED=false
REPORT_SQS_CONSUMER_ENABLED=false
REPORT_SQS_QUEUE_URL=
REPORT_SQS_WAIT_SECONDS=10
REPORT_JOB_MAX_ATTEMPTS=3
REPORT_MAX_ACTIVE_PER_USER=3
REPORT_JOB_BATCH_SIZE=2
REPORT_RETRY_DELAY_SECONDS=30
REPORT_STALE_AFTER_MINUTES=20
REPORT_RESULT_TTL_HOURS=24
REPORT_DOWNLOAD_EXPIRY_SECONDS=120
REPORT_PAGE_SIZE=500
REPORT_MAX_ROWS=100000
REPORT_MAX_OUTPUT_BYTES=52428800
