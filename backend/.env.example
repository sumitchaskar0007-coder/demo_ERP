# LOCAL workstation environment only. Managed AWS environments obtain values
# from ECS task definitions and Secrets Manager, never from a checked-in dotenv.
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8081
DB_URL=jdbc:postgresql://localhost:5432/college_erp
DB_USERNAME=postgres
DB_PASSWORD=postgres
JPA_DDL_AUTO=update
FLYWAY_ENABLED=false
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

JWT_SECRET=local-only-signing-secret-change-before-shared-use
JWT_EXPIRATION_MS=900000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Strict

RATE_LIMIT_REDIS_ENABLED=false
CACHE_REDIS_ENABLED=false
NOTICE_REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

BOOTSTRAP_ENABLED=true
BOOTSTRAP_RESET_EXISTING_PASSWORD=true
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@erp.com
SUPER_ADMIN_PHONE=9999999999
SUPER_ADMIN_PASSWORD=Admin@123456

MAIL_ENABLED=false
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_STARTTLS_ENABLED=false
MAIL_STARTTLS_REQUIRED=false
MAIL_FROM_ADDRESS=noreply@localhost
MAIL_REPLY_TO=noreply@localhost

REPORT_EXPORTS_ENABLED=true
REPORT_DATABASE_POLL_ENABLED=true
