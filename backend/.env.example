SERVER_PORT=8081
DB_URL=jdbc:postgresql://localhost:5432/college_erp
DB_USERNAME=postgres
DB_PASSWORD=change-me
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false
SPRING_PROFILES_ACTIVE=production
FLYWAY_ENABLED=false
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_CONNECTION_TIMEOUT_MS=30000
STORAGE_PROVIDER=s3
AWS_REGION=ap-south-1
AWS_PRIVATE_UPLOAD_BUCKET=replace-with-private-bucket-name
AWS_SECRETS_NAME=replace-with-secrets-manager-name
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=900000
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Strict
RATE_LIMIT_REDIS_ENABLED=true
REDIS_HOST=replace-with-private-redis-endpoint
REDIS_PORT=6379
CORS_ALLOWED_ORIGINS=https://erp.example.com
FRONTEND_URL=https://erp.example.com
BOOTSTRAP_ENABLED=false
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PHONE=
SUPER_ADMIN_PASSWORD=change-me
