{"info":{"name":"ERP Email Notifications","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"variable":[{"key":"baseUrl","value":"http://localhost:8081"},{"key":"token","value":""},{"key":"resetToken","value":""},{"key":"verificationToken","value":""},{"key":"notificationId","value":"1"}],"item":[{"name":"Forgot Password (neutral)","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"email\":\"user@example.com\"}"},"url":"{{baseUrl}}/api/auth/password/forgot"}},{"name":"Reset Password","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"token\":\"{{resetToken}}\",\"newPassword\":\"Secure@123\"}"},"url":"{{baseUrl}}/api/auth/password/reset"}},{"name":"Request Email Verification","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/auth/email-verification/request"}},{"name":"Confirm Email Verification","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"token\":\"{{verificationToken}}\"}"},"url":"{{baseUrl}}/api/auth/email-verification/confirm"}},{"name":"Monitor Queue","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/super-admin/email-notifications?page=0&size=10"}},{"name":"Retry Notification","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/super-admin/email-notifications/{{notificationId}}/retry"}},{"name":"Cancel Notification","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{baseUrl}}/api/super-admin/email-notifications/{{notificationId}}/cancel"}}]}
