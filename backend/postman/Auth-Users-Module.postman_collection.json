{
  "info": {
    "name": "College ERP - Auth and Users",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "superAdminToken", "value": "" },
    { "key": "principalToken", "value": "" },
    { "key": "collegeId", "value": "1" },
    { "key": "principalUserId", "value": "1" }
    ,{ "key": "superAdminEmail", "value": "" }
    ,{ "key": "superAdminPassword", "value": "" }
    ,{ "key": "principalEmail", "value": "" }
    ,{ "key": "principalPassword", "value": "" }
  ],
  "item": [
    {
      "name": "Login as Super Admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": { "mode": "raw", "raw": "{\"email\":\"{{superAdminEmail}}\",\"password\":\"{{superAdminPassword}}\"}" }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": ["const json = pm.response.json();", "pm.collectionVariables.set('superAdminToken', json.data.token);"] }
      }]
    },
    {
      "name": "Create Principal",
      "request": {
        "method": "POST",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{superAdminToken}}", "type": "string" }] },
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/super-admin/users/principals",
        "body": { "mode": "raw", "raw": "{\"collegeId\":{{collegeId}},\"fullName\":\"Dr. Rajesh Patil\",\"email\":\"{{principalEmail}}\",\"phone\":\"9876543210\",\"password\":\"{{principalPassword}}\"}" }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": ["const json = pm.response.json();", "pm.collectionVariables.set('principalUserId', json.data.id);"] }
      }]
    },
    {
      "name": "Login as Principal",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": { "mode": "raw", "raw": "{\"email\":\"{{principalEmail}}\",\"password\":\"{{principalPassword}}\"}" }
      },
      "event": [{
        "listen": "test",
        "script": { "exec": ["const json = pm.response.json();", "pm.collectionVariables.set('principalToken', json.data.token);"] }
      }]
    },
    {
      "name": "Principal Profile",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{principalToken}}", "type": "string" }] },
        "url": "{{baseUrl}}/api/auth/profile"
      }
    },
    {
      "name": "Principal Forbidden From Super Admin",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{principalToken}}", "type": "string" }] },
        "url": "{{baseUrl}}/api/super-admin/colleges"
      }
    },
    {
      "name": "Principal Access Departments",
      "request": {
        "method": "GET",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{principalToken}}", "type": "string" }] },
        "url": "{{baseUrl}}/api/principal/departments"
      }
    },
    {
      "name": "Deactivate Principal",
      "request": {
        "method": "PATCH",
        "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{superAdminToken}}", "type": "string" }] },
        "url": "{{baseUrl}}/api/super-admin/users/{{principalUserId}}/deactivate"
      }
    }
  ]
}
